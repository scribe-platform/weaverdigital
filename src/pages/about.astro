---
import Base from '../layouts/Base.astro';

const values = [
  ['Honest', 'Real numbers every month. No big promises.'],
  ['Simple', 'Plain English, no jargon. You can reach me directly.'],
  ['Yours', 'Your domain, your site, your name on it.'],
];
---
<Base title="About" description="Weaver Digital is Ashley Weaver's company, helping small local businesses get found online.">
  <section class="page-top dots">
    <div class="wrap about-grid">
      <div>
        <span class="tag reveal">About</span>
        <h1 class="reveal" data-delay="1">Hi, I'm <span class="thin">Ashley.</span></h1>
        <p class="big reveal" data-delay="2">
          I help the small businesses nobody else calls: handymen, groomers, bakers, cleaners.
          Great work, hard to find online. I fix that.
        </p>
      </div>
      <div class="badge-3d reveal" data-delay="2" data-tilt="16" aria-hidden="true">
        <div class="badge-face">
          <span class="lift">wd</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="values">
        {values.map(([title, line], i) => (
          <div class="value reveal" data-delay={String(i)}>
            <span class="value-num">0{i + 1}</span>
            <h2>{title}<span class="thin">.</span></h2>
            <p class="muted">{line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .page-top { padding: 160px 0 80px; margin-top: -76px; }
    .about-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: center; }
    .big { font-size: clamp(1.2rem, 2.2vw, 1.5rem); line-height: 1.45; margin-top: 28px; max-width: 560px; color: var(--gray); }
    .badge-3d { justify-self: center; width: min(320px, 70vw); aspect-ratio: 1; }
    .badge-face {
      width: 100%; height: 100%; border-radius: 26%;
      background: var(--charcoal); display: grid; place-items: center;
      box-shadow: var(--shadow-3), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      transform-style: preserve-3d;
      background-image: radial-gradient(circle at 30% 20%, rgba(142, 162, 255, 0.22), transparent 55%);
    }
    .badge-face span {
      font: 600 clamp(5rem, 16vw, 9rem)/1 var(--heading); letter-spacing: -0.06em; color: var(--white);
      transform: translateZ(50px);
      background: linear-gradient(90deg, var(--white) 52%, var(--light-blue) 52%);
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    }
    .values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
    .value { padding: 10px 32px 10px 0; border-left: 0; }
    .value + .value { padding-left: 32px; border-left: 1px solid var(--line); }
    .value-num { font: 300 1.2rem var(--heading); color: var(--blue); }
    .value h2 { margin: 18px 0 12px; }
    @media (max-width: 900px) {
      .about-grid { grid-template-columns: 1fr; }
      .page-top { padding-top: 130px; }
      .values { grid-template-columns: 1fr; gap: 36px; }
      .value, .value + .value { padding: 0; border: 0; }
    }
  </style>
</Base>
