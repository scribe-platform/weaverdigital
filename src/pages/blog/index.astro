---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/base';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base
  title="Blog"
  description="Notes from Weaver Digital on getting a small local business found online."
  noindex={posts.length === 0}
>
  <h1>Blog</h1>
  {posts.length === 0 && <p>No posts yet.</p>}
  <ul>
    {posts.map((post) => (
      <li>
        <a href={url(`/blog/${post.id}`)}>{post.data.title}</a>
        {post.data.author && <span class="author"> by {post.data.author}</span>}
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
        </time>
      </li>
    ))}
  </ul>
</Base>
