---
import Base from '../layouts/Base.astro';
import { url } from '../lib/base';
import { groups, icons } from '../lib/services';

const svg = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${icons[name]}</svg>`;

const checklist = ['Website', 'Hours & info', 'Photos', 'Reviews', 'Google posts'];
const tabs = [
  { id: 'site', label: 'Website', line: 'A clean site that works on phones. Change your hours or photos yourself, anytime.' },
  { id: 'google', label: 'Google listing', line: 'Your Google Business Profile claimed, verified and filled out, so you show up on the map.' },
  { id: 'reviews', label: 'Reviews', line: 'A link you text to happy customers. More reviews, more trust.' },
  { id: 'report', label: 'Monthly report', line: 'One page, every month, showing what changed.' },
];
const steps = [
  ['Talk', 'A quick call about your business.'],
  ['Preview', 'See your site before you decide.'],
  ['Launch', 'Site live, Google listing fixed.'],
  ['Grow', 'I keep it all running.'],
];
---
<Base title="Home" description="Websites, Google listings, reviews, social media and design for small local businesses.">
  <!-- HERO -->
  <section class="hero dots">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy reveal">
        <span class="tag">For small local businesses</span>
        <h1>Get found<br /><span class="thin">online.</span></h1>
        <p class="hero-sub muted">Websites, Google, reviews, social and design.<br />Done for you.</p>
        <div class="actions">
          <a class="btn btn-blue" href={url('/contact')}>Let's talk <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href={url('/services')}>See services</a>
        </div>
      </div>

      <div class="scene reveal" data-delay="1" aria-hidden="true">
        <div class="stack" data-tilt="10">
          <div class="map-layer">
            <span class="road r1"></span><span class="road r2"></span><span class="road r3"></span>
            <span class="pin p1"></span><span class="pin p2"></span><span class="pin p3 you">wd</span>
          </div>
          <div class="search-card">
            <div class="search-bar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <span id="typed"></span><span class="caret"></span>
            </div>
            <div class="results" id="results">
              <div class="row other" style="--pos:0"><i></i><b></b></div>
              <div class="row other" style="--pos:1"><i></i><b></b></div>
              <div class="row you" style="--pos:2">
                <i>wd</i>
                <div><strong>Your Business</strong><small>★★★★★ · Open now</small></div>
              </div>
            </div>
          </div>
          <span class="chip c1">★ 5.0</span>
          <span class="chip c2">📞 Call</span>
          <span class="chip c3">Open now</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FLIP THE SWITCH -->
  <section class="section">
    <div class="wrap flip-grid">
      <div class="reveal">
        <h2>Invisible<br />to <span class="thin">found.</span></h2>
        <p class="muted flip-sub">Flip it and see what changes.</p>
        <button class="switch" id="flip" role="switch" aria-checked="false">
          <span class="switch-label off">Today</span>
          <span class="switch-track"><span class="switch-knob"></span></span>
          <span class="switch-label on">With Weaver Digital</span>
        </button>
      </div>
      <div class="listing card reveal" data-delay="1" data-tilt="8" id="listing">
        <div class="listing-head">
          <span class="listing-pin">wd</span>
          <div>
            <strong>Your Business</strong>
            <small class="when-off">Unclaimed listing</small>
            <small class="when-on">★★★★★ · Open now</small>
          </div>
        </div>
        <ul class="listing-items">
          {checklist.map((item) => (
            <li><span>{item}</span><em class="when-off">Missing</em><em class="when-on">✓</em></li>
          ))}
        </ul>
        <div class="meter"><span>Visibility</span><div class="bar"><i></i></div></div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET (tabs) -->
  <section class="section get dots">
    <div class="wrap">
      <div class="head reveal">
        <h2>See it in <span class="thin">action.</span></h2>
        <p class="muted">The basics every business needs.</p>
      </div>
      <div class="tabs reveal" data-delay="1">
        <div class="tab-list" role="tablist">
          {tabs.map((t, i) => (
            <button role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="tab-num">0{i + 1}</span>
              <span class="tab-text"><strong>{t.label}</strong><small>{t.line}</small></span>
            </button>
          ))}
        </div>
        <div class="stage" data-tilt="8">
          <div class="panel" role="tabpanel" id="panel-site" aria-labelledby="tab-site">
            <div class="browser">
              <div class="browser-bar"><i></i><i></i><i></i><span>yourbusiness.com</span></div>
              <div class="browser-body">
                <span class="sk w60 big"></span><span class="sk w40"></span><span class="sk btnsk"></span>
                <div class="sk-row"><span></span><span></span><span></span></div>
              </div>
            </div>
            <div class="float-chip">Hours: 8am–5pm <b>✎ Edit</b></div>
          </div>
          <div class="panel" role="tabpanel" id="panel-google" aria-labelledby="tab-google" hidden>
            <div class="gcard">
              <div class="gmap"><span class="road r1"></span><span class="road r2"></span><span class="pin you">wd</span></div>
              <strong>Your Business</strong>
              <small>★★★★★ · Handyman · Open now</small>
              <div class="gbtns"><span>Website</span><span>Call</span><span>Directions</span></div>
            </div>
          </div>
          <div class="panel" role="tabpanel" id="panel-reviews" aria-labelledby="tab-reviews" hidden>
            <div class="phone">
              <div class="bubble out">Thanks for choosing us! Mind leaving a quick review? ⭐</div>
              <div class="bubble in">Done! 5 stars 🙌</div>
              <div class="stars">★★★★★</div>
            </div>
          </div>
          <div class="panel" role="tabpanel" id="panel-report" aria-labelledby="tab-report" hidden>
            <div class="report">
              <div class="report-head"><strong>Monthly report</strong><small>Example</small></div>
              <div class="bars">
                <div><i style="--h:48%"></i><small>Calls</small></div>
                <div><i style="--h:72%"></i><small>Directions</small></div>
                <div><i style="--h:90%"></i><small>Website visits</small></div>
              </div>
              <div class="report-foot">↑ Up from last month</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section on-dark dots how">
    <div class="wrap">
      <div class="head reveal">
        <h2>Four <span class="thin">steps.</span></h2>
        <p class="muted">You run your business. I handle the rest.</p>
      </div>
      <div class="steps" id="steps">
        <div class="steps-line"><i></i></div>
        {steps.map(([title, line], i) => (
          <div class="step reveal" data-delay={String(i)}>
            <span class="step-dot">{i + 1}</span>
            <h3>{title}</h3>
            <p class="muted">{line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ALL SERVICES -->
  <section class="section all dots">
    <div class="wrap">
      <div class="head reveal">
        <h2>Everything I <span class="thin">do.</span></h2>
        <a class="btn btn-ghost" href={url('/services')}>All services <span class="arrow">→</span></a>
      </div>
      <div class="all-grid">
        {groups.map((g, i) => (
          <a class="all-card card reveal" data-delay={String(i % 3)} data-tilt="9" href={url(`/services#${g.id}`)}>
            <div class="ico lift" set:html={svg(g.icon)} />
            <h3>{g.title}<span class="thin">{g.thin}</span></h3>
            <p class="muted">{g.line}</p>
            <ul>{g.items.map((it) => <li>{it.title}</li>)}</ul>
            <span class="all-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    /* Hero */
    .hero { position: relative; padding: 72px 0 120px; margin-top: -76px; padding-top: 160px; overflow: hidden; }
    .glow {
      position: absolute; width: 900px; height: 900px; right: -260px; top: -200px;
      background: radial-gradient(circle, rgba(142, 162, 255, 0.35), transparent 62%);
      pointer-events: none;
    }
    .hero-grid { position: relative; display: grid; grid-template-columns: 1fr 1.05fr; gap: 40px; align-items: center; }
    .hero-sub { font-size: 1.25rem; margin: 22px 0 34px; }

    .scene { perspective: 1400px; }
    .stack {
      position: relative; height: 470px;
      transform: perspective(1400px) rotateX(calc(10deg + var(--rx, 0deg))) rotateY(calc(-16deg + var(--ry, 0deg)));
      transform-style: preserve-3d;
    }
    .map-layer {
      position: absolute; inset: 30px 0 0 60px; border-radius: 28px;
      background: #e9ebf3; overflow: hidden;
      transform: translateZ(-60px); box-shadow: var(--shadow-2);
    }
    .road { position: absolute; background: var(--white); border-radius: 8px; }
    .r1 { left: -10%; right: -10%; top: 38%; height: 14px; transform: rotate(-8deg); }
    .r2 { top: -10%; bottom: -10%; left: 58%; width: 12px; transform: rotate(10deg); }
    .r3 { left: -10%; right: -10%; top: 74%; height: 9px; transform: rotate(4deg); }
    .pin {
      position: absolute; width: 22px; height: 22px; border-radius: 50% 50% 50% 0;
      transform: rotate(-45deg); background: #c5c8d3;
    }
    .p1 { left: 22%; top: 22%; } .p2 { left: 76%; top: 58%; }
    .pin.you {
      width: 42px; height: 42px; background: var(--blue); color: var(--white);
      display: grid; place-items: center; font: 600 0.85rem var(--heading);
      box-shadow: 0 10px 24px -6px rgba(58, 86, 212, 0.8);
    }
    .p3 { left: 64%; top: 26%; animation: bob 3s ease-in-out infinite; }
    @keyframes bob { 50% { translate: 0 -6px; } }

    .search-card {
      position: absolute; left: 0; top: 0; width: 78%;
      background: var(--white); border-radius: 22px; padding: 18px;
      box-shadow: var(--shadow-3); transform: translateZ(40px);
    }
    .search-bar {
      display: flex; align-items: center; gap: 10px;
      padding: 13px 16px; border-radius: 999px; background: var(--off-white);
      font-weight: 500; min-height: 50px;
    }
    .search-bar svg { width: 18px; height: 18px; color: var(--gray); flex: none; }
    .caret { width: 2px; height: 1.1em; background: var(--blue); animation: blink 1s steps(1) infinite; margin-left: -8px; }
    @keyframes blink { 50% { opacity: 0; } }
    .results { position: relative; height: 222px; margin-top: 14px; }
    .row {
      position: absolute; left: 0; right: 0; height: 66px;
      top: calc(var(--pos) * 76px);
      display: flex; align-items: center; gap: 12px; padding: 0 14px;
      border-radius: 16px; background: var(--off-white);
      transition: top 0.9s var(--ease), background 0.4s, box-shadow 0.4s, transform 0.9s var(--ease);
    }
    .row i { width: 38px; height: 38px; border-radius: 11px; background: #dfe1e8; flex: none; }
    .row b { height: 10px; width: 46%; border-radius: 6px; background: #dfe1e8; }
    .row.you i {
      display: grid; place-items: center; font: normal 600 0.85rem var(--heading);
      background: var(--charcoal); color: var(--light-blue);
    }
    .row.you div { display: flex; flex-direction: column; }
    .row.you strong { font-family: var(--heading); font-size: 1.02rem; }
    .row.you small { color: var(--gray); }
    .results.found .row.you {
      background: var(--white); transform: translateZ(30px) scale(1.04);
      box-shadow: 0 0 0 2px var(--blue), var(--shadow-2);
    }

    .chip {
      position: absolute; padding: 10px 16px; border-radius: 999px;
      background: var(--white); font-weight: 600; font-size: 0.9rem;
      box-shadow: var(--shadow-2); white-space: nowrap;
      animation: float 5s ease-in-out infinite;
    }
    .c1 { right: 4%; top: 6%; transform: translateZ(90px); }
    .c2 { right: 3%; top: 46%; transform: translateZ(120px); animation-delay: -1.6s; background: var(--blue); color: var(--white); }
    .c3 { left: 30%; bottom: 2%; transform: translateZ(70px); animation-delay: -3.2s; background: var(--charcoal); color: var(--white); }
    @keyframes float { 50% { translate: 0 -10px; } }

    /* Flip the switch */
    .flip-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
    .flip-sub { font-size: 1.15rem; margin: 18px 0 30px; }
    .switch {
      display: inline-flex; align-items: center; gap: 14px; flex-wrap: wrap;
      background: none; border: 0; padding: 0; cursor: pointer; font-weight: 600;
    }
    .switch-track {
      width: 76px; height: 42px; border-radius: 999px; background: #d9dae0; position: relative;
      box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.12); transition: background 0.4s var(--ease);
    }
    .switch-knob {
      position: absolute; top: 4px; left: 4px; width: 34px; height: 34px; border-radius: 50%;
      background: var(--white); box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
      transition: transform 0.45s var(--ease);
    }
    .switch[aria-checked='true'] .switch-track { background: var(--blue); }
    .switch[aria-checked='true'] .switch-knob { transform: translateX(34px); }
    .switch-label { transition: color 0.3s; }
    .switch[aria-checked='true'] .off, .switch[aria-checked='false'] .on { color: #a9abb3; }

    .listing { padding: 30px; }
    .listing-head { display: flex; gap: 14px; align-items: center; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
    .listing-pin {
      width: 52px; height: 52px; border-radius: 15px; display: grid; place-items: center;
      background: #dfe1e8; color: transparent; font: 600 1.05rem var(--heading);
      transition: background 0.5s, color 0.5s;
    }
    .listing-head div { display: flex; flex-direction: column; }
    .listing-head strong { font: 600 1.25rem var(--heading); }
    .listing-head small { color: var(--gray); }
    .listing-items { list-style: none; padding: 0; margin: 10px 0 22px; }
    .listing-items li { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; font-weight: 500; }
    .listing-items em { font-style: normal; font-size: 0.85rem; font-weight: 600; }
    .listing-items em.when-off { color: #a9abb3; border: 1.5px dashed #c9cad0; padding: 3px 10px; border-radius: 999px; }
    .listing-items em.when-on {
      width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center;
      background: var(--blue); color: var(--white);
    }
    .when-on { display: none !important; }
    .listing.on .when-on { display: grid !important; }
    .listing.on small.when-on { display: block !important; }
    .listing.on .when-off { display: none !important; }
    .listing.on .listing-pin { background: var(--charcoal); color: var(--light-blue); }
    .listing.on .listing-items li { animation: pop 0.5s var(--ease) both; }
    .listing.on .listing-items li:nth-child(2) { animation-delay: 0.07s; }
    .listing.on .listing-items li:nth-child(3) { animation-delay: 0.14s; }
    .listing.on .listing-items li:nth-child(4) { animation-delay: 0.21s; }
    .listing.on .listing-items li:nth-child(5) { animation-delay: 0.28s; }
    @keyframes pop { from { opacity: 0.3; transform: translateX(-8px); } }
    .meter { display: flex; align-items: center; gap: 14px; font-size: 0.85rem; font-weight: 600; color: var(--gray); }
    .meter .bar { flex: 1; height: 10px; border-radius: 999px; background: var(--off-white); overflow: hidden; }
    .meter .bar i { display: block; height: 100%; width: 12%; border-radius: inherit; background: #c9cad0; transition: width 1.1s var(--ease), background 0.5s; }
    .listing.on .meter .bar i { width: 94%; background: var(--blue); }

    /* Tabs */
    .tabs { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; align-items: center; }
    .tab-list { display: grid; gap: 8px; }
    .tab-list button {
      display: flex; gap: 18px; align-items: flex-start; text-align: left;
      padding: 20px 22px; border-radius: 20px; border: 0; background: transparent; cursor: pointer;
      transition: background 0.3s, box-shadow 0.3s;
    }
    .tab-list button:hover { background: rgba(255, 255, 255, 0.6); }
    .tab-list button[aria-selected='true'] { background: var(--white); box-shadow: var(--shadow-2); }
    .tab-num { font: 300 1.5rem/1.1 var(--heading); color: #a9abb3; transition: color 0.3s; }
    [aria-selected='true'] .tab-num { color: var(--blue); }
    .tab-text strong { display: block; font: 600 1.3rem var(--heading); letter-spacing: -0.02em; }
    .tab-text small { display: block; color: var(--gray); font-size: 0.95rem; max-height: 0; overflow: hidden; opacity: 0; transition: max-height 0.4s var(--ease), opacity 0.3s, margin 0.3s; }
    [aria-selected='true'] .tab-text small { max-height: 80px; opacity: 1; margin-top: 6px; }

    .stage {
      position: relative; height: 420px; border-radius: 32px;
      background: var(--charcoal); box-shadow: var(--shadow-3);
      display: grid; place-items: center; overflow: hidden;
      background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
      background-size: 22px 22px;
    }
    .panel { position: absolute; inset: 0; display: grid; place-items: center; padding: 32px; animation: panelIn 0.6s var(--ease); }
    .panel[hidden] { display: none; }
    @keyframes panelIn { from { opacity: 0; transform: translateY(20px) scale(0.96) rotateX(8deg); } }

    .browser { width: 100%; max-width: 380px; background: var(--white); border-radius: 18px; overflow: hidden; box-shadow: var(--shadow-3); }
    .browser-bar { display: flex; align-items: center; gap: 6px; padding: 12px 14px; background: var(--off-white); }
    .browser-bar i { width: 10px; height: 10px; border-radius: 50%; background: #d9dae0; }
    .browser-bar span { margin-left: 10px; font-size: 0.78rem; color: var(--gray); background: var(--white); padding: 3px 12px; border-radius: 999px; }
    .browser-body { padding: 26px 22px; display: grid; gap: 10px; }
    .sk { display: block; height: 10px; border-radius: 6px; background: #e6e7ec; }
    .sk.big { height: 22px; background: var(--charcoal); }
    .w60 { width: 70%; } .w40 { width: 45%; }
    .btnsk { width: 100px; height: 32px; border-radius: 999px; background: var(--blue); margin-top: 6px; }
    .sk-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 10px; }
    .sk-row span { height: 56px; border-radius: 10px; background: var(--off-white); }
    .float-chip {
      position: absolute; right: 10%; bottom: 14%;
      background: var(--white); padding: 12px 16px; border-radius: 14px; font-size: 0.9rem; font-weight: 500;
      box-shadow: var(--shadow-3); animation: float 4s ease-in-out infinite;
    }
    .float-chip b { color: var(--blue); margin-left: 8px; }

    .gcard { width: 100%; max-width: 340px; background: var(--white); border-radius: 20px; padding: 16px; box-shadow: var(--shadow-3); display: grid; gap: 4px; }
    .gmap { position: relative; height: 140px; border-radius: 14px; background: #e9ebf3; overflow: hidden; margin-bottom: 10px; }
    .gmap .pin.you { left: 46%; top: 30%; animation: bob 3s ease-in-out infinite; }
    .gcard strong { font: 600 1.2rem var(--heading); }
    .gcard small { color: var(--gray); }
    .gbtns { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }
    .gbtns span { font-size: 0.82rem; font-weight: 600; color: var(--blue); background: var(--blue-tint); padding: 6px 12px; border-radius: 999px; }

    .phone { width: 100%; max-width: 300px; background: var(--white); border-radius: 30px; padding: 26px 18px; box-shadow: var(--shadow-3); display: grid; gap: 12px; }
    .bubble { padding: 12px 15px; border-radius: 18px; font-size: 0.92rem; max-width: 85%; }
    .bubble.out { background: var(--blue); color: var(--white); justify-self: end; border-bottom-right-radius: 6px; }
    .bubble.in { background: var(--off-white); border-bottom-left-radius: 6px; animation: panelIn 0.6s var(--ease) 0.5s both; }
    .stars { text-align: center; font-size: 1.6rem; color: #f5b301; letter-spacing: 4px; animation: panelIn 0.6s var(--ease) 0.9s both; }

    .report { width: 100%; max-width: 340px; background: var(--white); border-radius: 20px; padding: 22px; box-shadow: var(--shadow-3); }
    .report-head { display: flex; justify-content: space-between; align-items: baseline; }
    .report-head strong { font: 600 1.15rem var(--heading); }
    .report-head small { color: var(--gray); }
    .bars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; height: 170px; margin: 20px 0 14px; align-items: end; }
    .bars div { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 8px; height: 100%; }
    .bars i { width: 100%; height: var(--h); border-radius: 10px 10px 4px 4px; background: linear-gradient(var(--light-blue), var(--blue)); animation: grow 1s var(--ease) both; transform-origin: bottom; }
    .bars div:nth-child(2) i { animation-delay: 0.1s; } .bars div:nth-child(3) i { animation-delay: 0.2s; }
    .bars small { font-size: 0.75rem; color: var(--gray); text-align: center; }
    @keyframes grow { from { transform: scaleY(0); } }
    .report-foot { font-weight: 600; color: var(--blue); font-size: 0.9rem; }

    /* Steps */
    .steps { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
    .steps-line { position: absolute; left: 24px; right: 24px; top: 24px; height: 2px; background: #33333a; }
    .steps-line i { display: block; height: 100%; width: var(--p, 0%); background: var(--light-blue); transition: width 0.15s linear; }
    .step { position: relative; }
    .step-dot {
      display: grid; place-items: center; width: 50px; height: 50px; border-radius: 50%;
      background: var(--charcoal-2); border: 2px solid #3a3a42; font: 600 1.1rem var(--heading);
      margin-bottom: 26px; position: relative; z-index: 1;
      transition: background 0.4s, border-color 0.4s, color 0.4s;
    }
    .step.lit .step-dot { background: var(--light-blue); border-color: var(--light-blue); color: var(--charcoal); }
    .step h3 { font-size: 1.6rem; margin-bottom: 8px; }

    /* All services */
    .all-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .all-card { position: relative; display: flex; flex-direction: column; gap: 10px; padding: 30px; text-decoration: none; color: var(--charcoal); min-height: 300px; }
    .all-card .ico { margin-bottom: 14px; transition: background 0.3s, color 0.3s; }
    .all-card:hover .ico { background: var(--blue); color: var(--white); }
    .all-card h3 { font-size: 1.6rem; }
    .all-card ul { list-style: none; padding: 0; margin: auto 0 0; display: flex; flex-wrap: wrap; gap: 6px; padding-top: 18px; }
    .all-card li { font-size: 0.8rem; font-weight: 500; padding: 5px 11px; border-radius: 999px; background: var(--off-white); color: var(--gray); }
    .all-go {
      position: absolute; top: 28px; right: 28px; width: 40px; height: 40px; border-radius: 50%;
      display: grid; place-items: center; color: var(--blue); box-shadow: inset 0 0 0 1.5px var(--line);
      transition: transform 0.35s var(--ease), background 0.3s, color 0.3s, box-shadow 0.3s;
    }
    .all-card:hover .all-go { background: var(--blue); color: var(--white); box-shadow: none; transform: rotate(-45deg); }

    @media (max-width: 900px) {
      .hero { padding-top: 130px; padding-bottom: 80px; }
      .hero-grid, .flip-grid, .tabs { grid-template-columns: 1fr; }
      .all-grid { grid-template-columns: 1fr 1fr; }
      .stack { height: 400px; transform: perspective(1400px) rotateX(8deg) rotateY(-8deg); }
      .search-card { width: 88%; }
      .chip.c2 { right: 0; }
      .steps { grid-template-columns: 1fr 1fr; row-gap: 40px; }
      .steps-line { display: none; }
      .stage { height: 380px; }
    }
    @media (max-width: 620px) { .all-grid { grid-template-columns: 1fr; } .all-card { min-height: 0; } }
    @media (max-width: 480px) {
      .steps { grid-template-columns: 1fr; }
      .map-layer { left: 30px; }
      .chip.c1 { right: 0; }
    }
  </style>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Hero: type a search, then "Your Business" rises to the top.
    const typed = document.getElementById('typed');
    const results = document.getElementById('results');
    const rows = results ? Array.from(results.querySelectorAll<HTMLElement>('.row')) : [];
    const queries = ['handyman near me', 'dog groomer near me', 'bakery near me', 'lawn care near me', 'house cleaner near me'];
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const setOrder = (found: boolean) => {
      results?.classList.toggle('found', found);
      // others: 0,1 ; you: 2  →  found: you 0, others 1,2
      rows[0].style.setProperty('--pos', found ? '1' : '0');
      rows[1].style.setProperty('--pos', found ? '2' : '1');
      rows[2].style.setProperty('--pos', found ? '0' : '2');
    };
    async function loop() {
      if (!typed || rows.length < 3) return;
      if (reduce) { typed.textContent = queries[0]; setOrder(true); return; }
      for (let q = 0; ; q = (q + 1) % queries.length) {
        setOrder(false);
        for (const ch of queries[q]) { typed.textContent += ch; await sleep(55 + Math.random() * 50); }
        await sleep(450);
        setOrder(true);
        await sleep(2600);
        while (typed.textContent) { typed.textContent = typed.textContent.slice(0, -1); await sleep(22); }
        await sleep(300);
      }
    }
    loop();

    // Invisible → found switch (auto-flips once when it scrolls into view)
    const flip = document.getElementById('flip');
    const listing = document.getElementById('listing');
    let touched = false;
    const setFlip = (on: boolean) => {
      flip?.setAttribute('aria-checked', String(on));
      listing?.classList.toggle('on', on);
    };
    flip?.addEventListener('click', () => {
      touched = true;
      setFlip(flip.getAttribute('aria-checked') !== 'true');
    });
    if (listing && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          io.disconnect();
          setTimeout(() => { if (!touched) setFlip(true); }, 1200);
        }
      }, { threshold: 0.6 });
      io.observe(listing);
    }

    // Tabs
    const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-list [role="tab"]'));
    const select = (btn: HTMLButtonElement) => {
      tabButtons.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(b.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
    };
    tabButtons.forEach((btn, i) => {
      btn.addEventListener('click', () => select(btn));
      btn.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        const next = tabButtons[(i + dir + tabButtons.length) % tabButtons.length];
        select(next);
        next.focus();
      });
    });

    // Steps: line fills and dots light up as you scroll through
    const stepsEl = document.getElementById('steps');
    const stepEls = stepsEl ? Array.from(stepsEl.querySelectorAll<HTMLElement>('.step')) : [];
    const onScroll = () => {
      if (!stepsEl) return;
      const r = stepsEl.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = Math.min(1, Math.max(0, (vh * 0.8 - r.top) / (vh * 0.5)));
      stepsEl.style.setProperty('--p', `${p * 100}%`);
      stepEls.forEach((s, i) => s.classList.toggle('lit', p >= i / (stepEls.length - 1) - 0.001));
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</Base>
