---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/base';

const guides = [
  {
    href: '/guides/your-web-address',
    title: 'Getting your web address',
    line: 'Buy your domain name, in your name, so you own it outright. About fifteen minutes.',
    meta: 'Start here · 15 min',
  },
  {
    href: '/guides/porkbun-access',
    title: 'Already have a domain at Porkbun?',
    line: 'Add me as an authorized user and I will do the connecting for you. No password needed.',
    meta: 'Instead of the first one · 10 min',
  },
  {
    href: '/guides/signing-in',
    title: 'Signing in to your website',
    line: 'Open the link we send you, pick your own password, and find your way around.',
    meta: '5 min',
  },
  {
    href: '/guides/estimate-requests',
    title: 'Getting told about new enquiries',
    line: 'Make sure an email lands in your inbox the moment somebody asks you for a price.',
    meta: '2 min',
  },
];
---
<Base
  title="Guides"
  description="Short, plain-English guides for Weaver Digital customers: getting your web address, signing in to your website, and getting notified about new enquiries."
  footerCta={false}
>
  <section class="page-top dots">
    <div class="wrap">
      <span class="tag reveal">Guides</span>
      <h1 class="reveal" data-delay="1">Everything you need, <span class="thin">step by step.</span></h1>
      <p class="lede muted reveal" data-delay="2">
        Short guides, plain English, no jargon. Work through them in order if you are just getting
        started — the first one is the only thing I need from you before your site can go live.
      </p>
    </div>
  </section>

  <section class="section list-sec">
    <div class="wrap narrow">
      <div class="list">
        {guides.map((g, i) => (
          <a class="row card reveal" data-delay={String(i)} href={url(g.href)}>
            <span class="num">0{i + 1}</span>
            <div class="body">
              <span class="meta">{g.meta}</span>
              <h2>{g.title}</h2>
              <p class="muted">{g.line}</p>
            </div>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <div class="note-block">
        <h3>More coming</h3>
        <p class="muted">
          I add a guide whenever a customer asks me something worth writing down. If you hit
          something that is not here, tell me — that is usually how the next one gets written.
        </p>
      </div>
    </div>
  </section>

  <style>
    .page-top { padding: 150px 0 60px; margin-top: -76px; }
    .narrow { max-width: 820px; }
    .lede { font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.5; margin-top: 24px; max-width: 640px; }
    .list-sec { padding-top: 48px; }
    .list { display: grid; gap: 14px; }
    .row {
      display: flex; align-items: center; gap: 26px;
      text-decoration: none; color: inherit;
      padding: 30px 32px;
      transition: box-shadow 0.35s var(--ease), transform 0.35s var(--ease);
    }
    .row:hover { transform: translateY(-2px); box-shadow: var(--shadow-2); }
    .num { font: 300 1.9rem/1 var(--heading); color: var(--blue); letter-spacing: -0.04em; flex: 0 0 auto; }
    .body { flex: 1; }
    .meta {
      display: inline-block; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--gray); margin-bottom: 8px;
    }
    .row h2 { font-size: 1.35rem; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 8px; }
    .go { font-size: 1.4rem; color: var(--blue); transition: transform 0.25s var(--ease); flex: 0 0 auto; }
    .row:hover .go { transform: translateX(5px); }
    .note-block { margin-top: 56px; padding-top: 36px; border-top: 1px solid var(--line); }
    .note-block h3 { margin-bottom: 8px; }
    @media (max-width: 700px) {
      .page-top { padding-top: 120px; }
      .row { flex-wrap: wrap; gap: 14px; padding: 26px 24px; }
      .num { flex-basis: 100%; }
      .go { display: none; }
    }
  </style>
</Base>
