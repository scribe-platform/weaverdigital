---
import Base from '../layouts/Base.astro';
import { url } from '../lib/base';
import { groups, icons } from '../lib/services';

const svg = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${icons[name]}</svg>`;
---
<Base title="Services" description="Websites, Google Business Profile and local SEO, reviews, social media, design, video, email and monthly reports for small local businesses.">
  <section class="page-top dots">
    <div class="wrap">
      <span class="tag reveal">Services</span>
      <h1 class="reveal" data-delay="1">Everything to <span class="thin">get found.</span></h1>
      <p class="muted sub reveal" data-delay="2">Pick one thing or let me handle all of it.</p>
    </div>
  </section>

  <nav class="jump" aria-label="Service areas">
    <div class="jump-inner">
      {groups.map((g, i) => (
        <a href={`#${g.id}`} data-jump={g.id} class={i === 0 ? 'active' : undefined}>
          <span set:html={svg(g.icon)} />{g.short}
        </a>
      ))}
    </div>
  </nav>

  {groups.map((g, gi) => (
    <section class={`group ${gi % 2 ? 'alt' : ''}`} id={g.id}>
      <div class="wrap group-grid">
        <div class="group-head reveal">
          <div class="big-ico" data-tilt="18"><span class="lift" set:html={svg(g.icon)} /></div>
          <span class="group-num">0{gi + 1}</span>
          <h2>{g.title}<span class="thin">{g.thin}</span></h2>
          <p class="muted">{g.line}</p>
        </div>
        <div class="items">
          {g.items.map((item, i) => (
            <div class="item card reveal" data-delay={String(i % 3)} data-tilt="10">
              <div class="ico lift" set:html={svg(item.icon)} />
              <div>
                <h3>{item.title}</h3>
                <p class="muted">{item.line}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section faq-sec">
    <div class="wrap faq-grid">
      <h2 class="reveal">Good to <span class="thin">know.</span></h2>
      <div class="faq reveal" data-delay="1">
        <details>
          <summary>Do I have to sign up for everything?</summary>
          <p>No. Start with what you need most. Most businesses start with a website and their Google listing, then add more later.</p>
        </details>
        <details>
          <summary>How soon will I see results?</summary>
          <p>Usually around 90 days, and six months for real momentum. Fixing an unclaimed Google listing can be quicker.</p>
        </details>
        <details>
          <summary>Who owns my website?</summary>
          <p>You do. Your domain is in your name from day one. If you ever leave, you keep it, plus a working copy of your site.</p>
        </details>
        <details>
          <summary>Can I make changes myself?</summary>
          <p>Yes, anytime. And for anything bigger, I'll do it for you.</p>
        </details>
        <details>
          <summary>Can you guarantee I'll be #1 on Google?</summary>
          <p>No, and nobody honestly can. I guarantee the work, and you'll see the results in your report every month.</p>
        </details>
      </div>
    </div>
  </section>

  <style>
    .page-top { padding: 150px 0 56px; margin-top: -76px; }
    .sub { font-size: 1.25rem; margin-top: 20px; }

    /* Sticky jump bar */
    .jump { position: sticky; top: 92px; z-index: 40; padding: 0 14px; margin-bottom: 8px; }
    .jump-inner {
      max-width: 1120px; margin: 0 auto; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none;
      padding: 6px; border-radius: 999px;
      background: rgba(255, 255, 255, 0.78);
      -webkit-backdrop-filter: blur(14px) saturate(1.4); backdrop-filter: blur(14px) saturate(1.4);
      box-shadow: var(--shadow-1);
    }
    .jump-inner::-webkit-scrollbar { display: none; }
    .jump a {
      flex: none; display: inline-flex; align-items: center; gap: 8px;
      padding: 9px 16px; border-radius: 999px; font-weight: 500; font-size: 0.92rem;
      color: var(--charcoal); text-decoration: none; white-space: nowrap;
      transition: background 0.25s, color 0.25s;
    }
    .jump a :global(svg) { width: 17px; height: 17px; color: var(--blue); transition: color 0.25s; }
    .jump a:hover { background: var(--off-white); }
    .jump a.active { background: var(--charcoal); color: var(--white); }
    .jump a.active :global(svg) { color: var(--light-blue); }

    /* Groups */
    .group { padding: 96px 0; scroll-margin-top: 150px; }
    .group.alt { background: var(--white); }
    .group.alt .card { background: var(--off-white); box-shadow: none; }
    .group.alt .card:hover { background: var(--white); box-shadow: var(--shadow-2); }
    .group-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 56px; align-items: start; }
    .group-head { position: sticky; top: 170px; }
    .big-ico {
      width: 88px; height: 88px; border-radius: 26px; background: var(--charcoal); color: var(--light-blue);
      display: grid; place-items: center; margin-bottom: 28px;
      box-shadow: var(--shadow-3);
      background-image: radial-gradient(circle at 30% 20%, rgba(142, 162, 255, 0.25), transparent 60%);
    }
    .big-ico :global(svg) { width: 38px; height: 38px; }
    .group-num { display: block; font: 300 1.1rem var(--heading); color: var(--blue); margin-bottom: 10px; }
    .group-head h2 { margin-bottom: 14px; }
    .group-head p { font-size: 1.15rem; }
    .items { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .item { display: flex; flex-direction: column; gap: 22px; padding: 24px; }
    .item h3 { margin-bottom: 4px; }
    .item:hover .ico { background: var(--blue); color: var(--white); }
    .ico { transition: background 0.3s, color 0.3s; }

    .faq-sec { background: var(--off-white); }
    .faq-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 48px; align-items: start; }

    @media (max-width: 900px) {
      .page-top { padding-top: 130px; padding-bottom: 40px; }
      .jump { top: 84px; }
      .group { padding: 64px 0; }
      .group-grid, .faq-grid { grid-template-columns: 1fr; gap: 32px; }
      .group-head { position: static; }
      .big-ico { width: 72px; height: 72px; border-radius: 22px; margin-bottom: 20px; }
    }
    @media (max-width: 560px) {
      .items { grid-template-columns: 1fr; }
      .item { flex-direction: row; align-items: flex-start; gap: 16px; padding: 20px; }
      .item .ico { flex: none; }
    }
  </style>

  <script>
    // Highlight the jump-bar chip for the section on screen, and keep it scrolled into view.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.jump a'));
    const sections = links.map((a) => document.getElementById(a.dataset.jump!)).filter(Boolean) as HTMLElement[];
    const setActive = (id: string) => {
      links.forEach((a) => {
        const on = a.dataset.jump === id;
        if (on && !a.classList.contains('active')) {
          a.parentElement?.scrollTo({ left: a.offsetLeft - 12, behavior: 'smooth' });
        }
        a.classList.toggle('active', on);
      });
    };
    const onScroll = () => {
      const mark = window.innerHeight * 0.35;
      let current = sections[0]?.id;
      for (const s of sections) if (s.getBoundingClientRect().top <= mark) current = s.id;
      if (current) setActive(current);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</Base>
