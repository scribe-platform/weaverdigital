---
import Base from './Base.astro';
import { url } from '../lib/base';
import { EMAIL_HREF, PHONE, PHONE_HREF } from '../lib/contact';

export interface Props {
  title: string;
  eyebrow?: string;
  heading: string;
  thin?: string;
  intro: string;
  description?: string;
}

const { title, eyebrow = 'Guide', heading, thin, intro, description } = Astro.props;
---
<Base title={title} description={description ?? intro} footerCta={false}>
  <section class="guide-top dots">
    <div class="wrap">
      <a class="back reveal" href={url('/guides')}><span class="arrow">←</span> All guides</a>
      <span class="tag reveal" data-delay="1">{eyebrow}</span>
      <h1 class="reveal" data-delay="1">{heading}{thin && <span class="thin"> {thin}</span>}</h1>
      <p class="lede muted reveal" data-delay="2">{intro}</p>
    </div>
  </section>

  <section class="guide-body">
    <div class="wrap narrow">
      <slot />
    </div>
  </section>

  <section class="guide-end">
    <div class="wrap narrow">
      <div class="end-card card">
        <div>
          <h3>Stuck on any of this?</h3>
          <p class="muted">Text me, or send a note. I would rather you ask than wrestle with it.</p>
        </div>
        <div class="end-actions">
          <a class="btn btn-blue" href={EMAIL_HREF}>Email Ashley <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href={PHONE_HREF}>{PHONE}</a>
        </div>
      </div>
      <a class="back bottom" href={url('/guides')}><span class="arrow">←</span> All guides</a>
    </div>
  </section>

  <style>
    .guide-top { padding: 150px 0 64px; margin-top: -76px; }
    .narrow { max-width: 760px; }
    .back {
      display: flex; width: fit-content; align-items: center; gap: 8px;
      font-size: 0.92rem; font-weight: 500; text-decoration: none; color: var(--gray);
      margin-bottom: 22px;
    }
    .back:hover { color: var(--blue); }
    .back .arrow { transition: transform 0.25s var(--ease); }
    .back:hover .arrow { transform: translateX(-4px); }
    .back.bottom { margin: 40px 0 0; }
    .guide-top h1 { font-size: clamp(2.4rem, 6vw, 4rem); }
    .lede { font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.5; margin-top: 22px; max-width: 620px; }
    .guide-body { padding: 24px 0 8px; }
    .guide-end { padding: 40px 0 112px; }
    .end-card { display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; }
    .end-card h3 { margin-bottom: 6px; }
    .end-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    @media (max-width: 800px) {
      .guide-top { padding-top: 120px; }
      .guide-end { padding-bottom: 80px; }
    }
  </style>

  <style is:global>
    /* Guide content vocabulary — shared by every page using this layout. */
    .steps { counter-reset: step; display: grid; gap: 14px; margin: 8px 0 0; }
    .step {
      counter-increment: step;
      position: relative;
      background: var(--white);
      border-radius: 22px;
      padding: 30px 32px 30px 86px;
      box-shadow: var(--shadow-1);
    }
    .step::before {
      content: counter(step);
      position: absolute; left: 30px; top: 28px;
      font: 300 1.9rem/1 var(--heading);
      color: var(--blue);
      letter-spacing: -0.04em;
    }
    .step h2 { font-size: 1.35rem; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 10px; }
    .step p { color: var(--gray); }
    .step p + p { margin-top: 12px; }
    .step ul { color: var(--gray); margin: 12px 0 0; padding-left: 20px; }
    .step li + li { margin-top: 8px; }
    .step .actions { margin-top: 20px; }
    .step strong { color: var(--charcoal); font-weight: 600; }
    .step code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.9em; background: var(--blue-tint); color: var(--blue-dark);
      padding: 2px 7px; border-radius: 6px;
    }

    /* A short aside: a tip, or something not to do. */
    .note {
      display: flex; gap: 14px; align-items: flex-start;
      background: var(--blue-tint);
      border-radius: 18px; padding: 20px 24px; margin: 14px 0 0;
      font-size: 0.97rem; color: var(--charcoal);
    }
    .note::before { content: 'i'; font: 600 0.85rem/20px var(--heading); flex: 0 0 20px; height: 20px; text-align: center; border-radius: 50%; background: var(--blue); color: var(--white); margin-top: 2px; }
    .note.warn { background: #fdf3e7; }
    .note.warn::before { content: '!'; background: #c77b1f; }
    .note p { margin: 0; }
    .note strong { font-weight: 600; }

    .guide-section { margin-top: 56px; }
    .guide-section > h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); margin-bottom: 18px; }
    .guide-section > p { color: var(--gray); }
    .guide-section > p + p { margin-top: 14px; }
    .guide-section > .actions { margin: 26px 0 0; }
    .guide-section > .actions + p { margin-top: 22px; }

    @media (max-width: 700px) {
      .step { padding: 26px 24px 26px 24px; }
      .step::before { position: static; display: block; margin-bottom: 8px; }
    }
  </style>
</Base>
