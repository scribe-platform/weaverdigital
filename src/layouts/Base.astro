---
import { url } from '../lib/base';
import {
  SITE_NAME,
  UMAMI_SCRIPT_URL,
  UMAMI_WEBSITE_ID,
} from '../site-config';
import '../styles/global.css';

export interface Props {
  title: string;
  siteName?: string;
  description?: string;
  footerCta?: boolean;
}

const { title, siteName = SITE_NAME, description, footerCta = true } = Astro.props;
const fullTitle = title === 'Home' ? `${siteName} · Get found online` : `${title} · ${siteName}`;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
];
const isCurrent = (href: string) => path.replace(/\/$/, '') === href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@300;600&display=swap" rel="stylesheet" />
      <!-- Analytics (ADR 0001) — cookieless, so no consent banner, and deferred
         so it never blocks the page. Absent when the Site isn't registered. -->
    {UMAMI_WEBSITE_ID && UMAMI_SCRIPT_URL && (
      <script defer src={UMAMI_SCRIPT_URL} data-website-id={UMAMI_WEBSITE_ID}></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="nav-pill">
        <a href={url('/')} class="logo" aria-label={`${siteName} home`}>
          <img src={url('/brand/logo.png')} alt={siteName} width="150" height="42" />
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu"><span></span></button>
        <nav id="site-nav">
          {nav.map((item) => (
            <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href={url('/contact')} class="btn btn-blue">Let's talk</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        {footerCta && (
          <div class="footer-cta">
            <h2>Ready to be <span class="thin" style="color: var(--light-blue)">found?</span></h2>
            <a class="btn btn-blue" href={url('/contact')}>Let's talk <span class="arrow">→</span></a>
          </div>
        )}
        <div class="footer-row">
          <img src={url('/brand/logo-dark.png')} alt={siteName} width="140" height="39" />
          <nav>
            {nav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
            <a href={url('/contact')}>Contact</a>
            <a href="mailto:ashley@weaverdigital.io">ashley@weaverdigital.io</a>
          </nav>
          <span>&copy; {new Date().getFullYear()} {siteName}</span>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
