---
import { url } from '../lib/base';
import { SITE_NAME } from '../site-config';
import '../styles/global.css';

export interface Props {
  title: string;
  siteName?: string;
  description?: string;
}

const { title, siteName = SITE_NAME, description } = Astro.props;
const fullTitle = title === 'Home' ? `${siteName} · Get found online` : `${title} · ${siteName}`;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [
  { href: '/services', label: 'Services' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/about', label: 'About' },
];
const isCurrent = (href: string) => path.replace(/\/$/, '') === href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@300;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href={url('/')} class="logo" aria-label={`${siteName} home`}>
          <img src={url('/brand/logo.png')} alt={siteName} width="180" height="50" />
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav id="site-nav">
          {nav.map((item) => (
            <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href={url('/contact')} class="btn btn-blue nav-cta">Get in touch</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <img src={url('/brand/logo-dark.png')} alt={siteName} width="180" height="50" />
          <p>Websites and Google listings for small local businesses.</p>
        </div>
        <nav class="footer-nav">
          {nav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
          <a href={url('/contact')}>Contact</a>
        </nav>
        <div>
          <a href="mailto:ashley@weaverdigital.io">ashley@weaverdigital.io</a>
        </div>
      </div>
      <p class="wrap copyright">&copy; {new Date().getFullYear()} {siteName}</p>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.querySelector('.menu-toggle');
        var nav = document.getElementById('site-nav');
        if (!btn || !nav) return;
        btn.addEventListener('click', function () {
          var open = nav.classList.toggle('open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      })();
    </script>
  </body>
</html>
